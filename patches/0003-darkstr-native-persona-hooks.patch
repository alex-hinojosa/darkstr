+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/**
+ * darkstr M3 — JSWindowActor child. Minimum Navigator fields from same seed as HTTP UA.
+ * Brand: darkstr — not official LibreWolf. No Client Hints SET (Firefox host).
+ */
+
+function spoof(proto, prop, getter) {
+  try {
+    Object.defineProperty(proto, prop, {
+      configurable: true,
+      enumerable: true,
+      get: getter,
+    });
+  } catch (_e) {}
+}
+
+export class DarkstrNativePersonaChild extends JSWindowActorChild {
+  async handleEvent(event) {
+    if (event.type !== "DOMWindowCreated") {
+      return;
+    }
+    let snapshot;
+    try {
+      snapshot = await this.sendQuery("DarkstrNativePersona:GetSnapshot");
+    } catch (_e) {
+      return;
+    }
+    if (!snapshot || !snapshot.userAgent) {
+      return;
+    }
+    const win = this.contentWindow;
+    if (!win || !win.Navigator) {
+      return;
+    }
+    const navProto = win.Navigator.prototype;
+    spoof(navProto, "userAgent", () => snapshot.userAgent);
+    spoof(navProto, "platform", () => snapshot.platform || "MacIntel");
+    spoof(navProto, "hardwareConcurrency", () =>
+      Number(snapshot.hardwareConcurrency) || 8
+    );
+    if ("deviceMemory" in navProto || true) {
+      spoof(navProto, "deviceMemory", () => Number(snapshot.deviceMemory) || 8);
+    }
+    const langs = Array.isArray(snapshot.languages)
+      ? snapshot.languages.slice()
+      : ["en-US", "en"];
+    spoof(navProto, "language", () => langs[0] || "en-US");
+    spoof(navProto, "languages", () => langs.slice());
+    // Firefox host: never expose userAgentData / never SET CH from content.
+    try {
+      spoof(navProto, "userAgentData", () => undefined);
+    } catch (_e) {}
+  }
+}
