+function pixelNoise(seed, i, val) {
+  let h = seed ^ (i * 2654435761);
+  h = (h ^ (val * 2246822519)) >>> 0;
+  h = Math.imul(h ^ (h >>> 16), 0x45d9f3b);
+  h = Math.imul(h ^ (h >>> 16), 0x45d9f3b);
+  h = (h ^ (h >>> 16)) >>> 0;
+  const magnitude = (h >>> 1) & 3;
+  return h & 1 ? magnitude : -magnitude;
+}
