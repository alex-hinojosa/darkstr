+    // with profiles.js (gpu after screen/colorDepth):
+    const gpu2 = pickFrom(gpus, rng);
+    void pickFrom([0, 1], rng); // languages
+    void pickFrom([0, 1], rng); // timezone
+    const canvasSeed = (rng() * 0xffffffff) >>> 0;
+    const audioSeed = (rng() * 0xffffffff) >>> 0;
+    return {
+      canvasSeed,
+      audioSeed,
+      gpu: gpu2 || gpu,
+    };
+  },
