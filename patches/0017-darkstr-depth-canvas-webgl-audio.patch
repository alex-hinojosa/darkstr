+  // Restore only our own wrapper; never clobber a page replacement installed later.
+  if (methodIsInstalled(replacement)) {
+    Object.defineProperty(
+      replacement.proto,
+      replacement.name,
+      replacement.originalDescriptor
+    );
+  }
