+  try {
+    const waived = Cu.waiveXrays(rawWindow);
+    if (waived) {
+      return waived;
+    }
+  } catch (_e) {}
+  try {
+    if (rawWindow?.wrappedJSObject) {
+      return rawWindow.wrappedJSObject;
+    }
+  } catch (_e) {}
+  throw new Error("unable to obtain waived content window");
