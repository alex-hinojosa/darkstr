# darkstr pin 0047 — darkstr start page + full-bleed Dock icon
# Train: LibreWolf 156.0.1-1. Requires pins 0045 (browser/branding/darkstr) + 0046 (icon E).
# Apply (Mini): scripts/apply-0047-startpage-dockicon-mini.sh   (copies binaries from patches/0047-files, then patch -p1 below)
#
# Start page (about:home = default homepage/new window, about:newtab, private-window about:privatebrowsing):
#   before: jet tile (about-logo.png, 0046) + "LibreWolf" wordmark (chrome://branding/content/firefox-wordmark.svg,
#           LibreWolf's Inkscape outline path, fill:context-fill = #20123A light / #fbfbfe dark).
#   after:  PM jet mark (darkstr-jet-mark.svg: outline only, #9AAEFF, no tile) + lowercase "darkstr" wordmark
#           (IBM Plex Sans Condensed SemiBold outlined to paths; #E8E9F0 when the page is dark, #1C1E28 when light).
#   Only branding-package files change (browser/branding/darkstr/content):
#     firefox-wordmark.svg                     <- patches/0047-files/startpage/firefox-wordmark.svg (diff below)
#     about-logo{,-private}{,@2x}.png          <- patches/0047-files/startpage/about-logo{,@2x}.png (binary)
#   No activity-stream file, CSS, HTML, string, pref, search engine, link or widget is changed. Layout is the
#   existing newtab row (64px logo, wordmark to its right) — stacking the wordmark UNDER the mark would need an
#   activity-stream (web-accessible) CSS change, so it was not done. chrome://branding/content stays unreachable
#   from pages (img + fetch probe on the 0047 DMG).
#   Side effect: about-logo.png is also used by moz-page-nav (about:preferences etc.), the fxms bookmarks-menu
#   button and the QR-code centre logo — those now show the outline mark instead of the 0046 tile.
#   Homepage: about:home (not a LibreWolf-branded page) — unchanged.
#
# Dock icon (macOS 26/27 gray "legacy" plate):
#   firefox.icns <- PM darkstr-fullbleed.iconset via scripts/darkstr-icon-from-png.sh ... --iconset (binary; heavy 16/32).
#   Measured: an .icns-only bundle is still drawn inside the gray plate on macOS 27.0.1 (full-bleed AND Big Sur
#   template art). The plate goes away only with an asset-catalog icon: Assets.car compiled by Xcode actool from an
#   Icon Composer-style AppIcon.icon (scripts/darkstr-icon-assets-car.sh) + CFBundleIconName=AppIcon. firefox.icns
#   stays CFBundleIconFile (fallback). Text changes below: browser/app/moz.build (install Assets.car for the darkstr
#   branding dir), Info.plist.in (CFBundleIconName), package-manifest.in (@RESPATH@/Assets.car).
#   document.icns, disk.icns, default*.png: unchanged from 0046.
# Not web-visible: UA / navigator / headers identical to 0046; DarkstrModeXor untouched.
--- a/browser/app/moz.build
+++ b/browser/app/moz.build
@@ -75,6 +75,9 @@
         (f"{branding}/firefox.icns", "Resources/firefox.icns"),
         (f"{branding}/document.icns", "Resources/document.icns"),
     ]
+    # darkstr 0047: macOS 26+ icon (Assets.car / CFBundleIconName "AppIcon"); firefox.icns stays the fallback.
+    if CONFIG["MOZ_BRANDING_DIRECTORY"].endswith("branding/darkstr"):
+        extra_files.append((f"{branding}/Assets.car", "Resources/Assets.car"))
     if CONFIG["MOZ_UPDATER"]:
         extra_files.append((
             f"!/{FINAL_TARGET}/org.mozilla.updater",
--- a/browser/app/macbuild/Contents/Info.plist.in
+++ b/browser/app/macbuild/Contents/Info.plist.in
@@ -190,6 +190,8 @@
 	<string>@MAC_APP_NAME@ @APP_VERSION@</string>
 	<key>CFBundleIconFile</key>
 	<string>firefox.icns</string>
+	<key>CFBundleIconName</key>
+	<string>AppIcon</string>
 	<key>CFBundleIdentifier</key>
 	<string>@MOZ_MACBUNDLE_ID@</string>
 	<key>CFBundleInfoDictionaryVersion</key>
--- a/browser/installer/package-manifest.in
+++ b/browser/installer/package-manifest.in
@@ -42,6 +42,8 @@
 @APPNAME@/Contents/PkgInfo
 @RESPATH@/firefox.icns
 @RESPATH@/document.icns
+; darkstr 0047: macOS 26+ app icon (CFBundleIconName AppIcon), from browser/branding/darkstr/Assets.car
+@RESPATH@/Assets.car
 @RESPATH@/@LPROJ_ROOT@.lproj/*
 #endif
 
--- a/browser/branding/darkstr/content/firefox-wordmark.svg
+++ b/browser/branding/darkstr/content/firefox-wordmark.svg
