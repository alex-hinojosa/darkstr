+function uaOsToken(ua) {
+  const m = /^Mozilla\/5\.0 \(([^()]+?); rv:/.exec(String(ua || ""));
+  return m ? m[1] : "";
+}
+
+function osOfToken(token) {
+  if (/Windows/.test(token)) {
+    return "windows";
+  }
+  if (/Macintosh|Mac OS X/.test(token)) {
+    return "macos";
+  }
+  if (/X11|Linux/.test(token)) {
+    return "linux";
+  }
+  return null;
+}
