+function osOfPlatform(platform) {
+  const p = String(platform || "");
+  if (/^Win/.test(p)) {
+    return "windows";
+  }
+  if (/^Mac/.test(p)) {
+    return "macos";
+  }
+  if (/Linux/.test(p)) {
+    return "linux";
+  }
+  return null;
