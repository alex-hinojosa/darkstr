+/**
+ * darkstr Phase 5 pin 0035 — Cookie firewall JSWindowActor parent.
+ * Brand: darkstr — not official LibreWolf.
+ *
+ * All script-path cookie reads/writes IPC here so HTTP observers and
+ * document.cookie / CookieStore share one sandbox jar (no split-brain).
+ */
+
+export class DarkstrCookieFirewallParent extends JSWindowActorParent {
+  receiveMessage(message) {
+    try {
+      const { DarkstrCookieFirewall } = ChromeUtils.importESModule(
+        "moz-src:///browser/components/DarkstrCookieFirewall.sys.mjs"
+      );
+      const bc = this.browsingContext;
+      switch (message.name) {
+        case "DarkstrCookieFirewall:GetPolicy":
+          return DarkstrCookieFirewall.policyForBrowsingContext(bc);
+        case "DarkstrCookieFirewall:GetDocumentCookie":
+          return DarkstrCookieFirewall.getDocumentCookie(bc);
+        case "DarkstrCookieFirewall:SetDocumentCookie":
+          return DarkstrCookieFirewall.setDocumentCookie(
+            bc,
+            message.data?.raw ?? ""
+          );
+        case "DarkstrCookieFirewall:StoreGet":
+          return DarkstrCookieFirewall.storeGet(bc, message.data?.name);
+        case "DarkstrCookieFirewall:StoreSet":
+          return DarkstrCookieFirewall.storeSet(
+            bc,
+            message.data?.name,
+            message.data?.value
+          );
+        case "DarkstrCookieFirewall:StoreDelete":
+          return DarkstrCookieFirewall.storeDelete(bc, message.data?.name);
+        case "DarkstrCookieFirewall:InstallStatus":
+          DarkstrCookieFirewall.recordInstallStatus(message.data, bc);
+          return null;
+        default:
+          return null;
+      }
+    } catch (error) {
+      console.error("darkstr 0035 cookie parent IPC failed", error);
+    }
+    return null;
+  }
+}
