 #include "mozilla/Preferences.h"
 #include "nsString.h"
+#include "nsTHashMap.h"
 
 namespace mozilla {
 
+namespace {
+
+nsTHashMap<nsUint64HashKey, uint32_t>& TopLoads() {
+  // Main-thread DocShell LoadURI path only (155 train).
+  static nsTHashMap<nsUint64HashKey, uint32_t> sTopLoads;
+  return sTopLoads;
+}
+
+void SyncPhaseMirror(uint32_t aCount) {
+  // Mirror for chrome JS / prefs consumers. Multi-tab limited (last writer).
+  if (aCount <= 1) {
+    Preferences::SetCString("darkstr.persona.docShellPhase", "first_document"_ns);
+  } else {
+    Preferences::SetCString("darkstr.persona.docShellPhase", "subsequent_nav"_ns);
+  }
+}
+
+}  // namespace
+
 bool DarkstrDocShellHooks::PollutionNativeHooksActive() {
   if (!Preferences::GetBool("darkstr.nativePersonaHooks", false)) {
     return false;
@@ -24,7 +44,6 @@
 }
 
 DarkstrDocShellHooks::NavPhase DarkstrDocShellHooks::PhaseFromChromeMirror() {
-  // Honest stub: chrome DarkstrNativePersona counter remains SoT (0003).
   if (!PollutionNativeHooksActive()) {
     return NavPhase::SubsequentNav;
   }
@@ -37,9 +56,45 @@
   return NavPhase::SubsequentNav;
 }
 
-void DarkstrDocShellHooks::NoteTopLevelDocumentLoadAttempt() {
-  // No-op behavioral stub: chrome counter + mirror remain SoT.
-  (void)PhaseFromChromeMirror();
+DarkstrDocShellHooks::NavPhase DarkstrDocShellHooks::CurrentPhase(
+    uint64_t aBrowsingContextId) {
+  if (!PollutionNativeHooksActive()) {
+    return NavPhase::SubsequentNav;
+  }
+  if (aBrowsingContextId == 0) {
+    return PhaseFromChromeMirror();
+  }
+  uint32_t n = 0;
+  if (!TopLoads().Get(aBrowsingContextId, &n) || n == 0) {
+    return PhaseFromChromeMirror();
+  }
+  return n <= 1 ? NavPhase::FirstDocument : NavPhase::SubsequentNav;
 }
 
+bool DarkstrDocShellHooks::ShouldApplyPersona(uint64_t aBrowsingContextId) {
+  if (!PollutionNativeHooksActive()) {
+    return false;
+  }
+  if (Preferences::GetBool("darkstr.strictFirstDoc", true) &&
+      CurrentPhase(aBrowsingContextId) == NavPhase::FirstDocument) {
+    return false;
+  }
+  return true;
+}
+
+void DarkstrDocShellHooks::NoteTopLevelDocumentLoadAttempt(
+    uint64_t aBrowsingContextId) {
+  if (!PollutionNativeHooksActive()) {
+    return;
+  }
+  if (aBrowsingContextId == 0) {
+    return;
+  }
+  uint32_t n = 0;
+  (void)TopLoads().Get(aBrowsingContextId, &n);
+  n += 1;
+  TopLoads().InsertOrUpdate(aBrowsingContextId, n);
+  SyncPhaseMirror(n);
+}
+
 }  // namespace mozilla
