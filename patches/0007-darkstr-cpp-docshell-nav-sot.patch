+DarkstrDocShellHooks::NavPhase DarkstrDocShellHooks::CurrentPhase(
+    uint64_t aBrowsingContextId) {
+  if (!PollutionNativeHooksActive()) {
+    return NavPhase::SubsequentNav;
+  }
+  uint32_t n = 0;
+  if (!TopLoads().Get(aBrowsingContextId, &n) || n == 0) {
+    // No note yet — treat as first until a LoadURI lands.
+    return NavPhase::FirstDocument;
+  }
+  return (n <= 1) ? NavPhase::FirstDocument : NavPhase::SubsequentNav;
