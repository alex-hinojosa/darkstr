 // static
+bool CookieCommons::DarkstrContentGateBlocks(Document* aDocument,
+                                             nsIPrincipal* aPrincipal) {
+  if (!StaticPrefs::darkstr_cookieFirewall_contentGate()) {
+    return false;
+  }
+  if (!NS_IsMainThread()) {
+    return true;
+  }
+  nsIPrincipal* principal =
+      aPrincipal ? aPrincipal : (aDocument ? aDocument->NodePrincipal() : nullptr);
+  // The firewall only owns http(s) web content; other schemes keep stock
+  // behaviour (and mostly have no cookie access anyway).
+  if (principal && !principal->SchemeIs("http") &&
+      !principal->SchemeIs("https")) {
+    return false;
+  }
+  if (!aDocument || !nsContentUtils::IsSafeToRunScript()) {
+    return true;
+  }
+  nsCOMPtr<nsIObserverService> os = mozilla::services::GetObserverService();
+  if (!os) {
+    return true;
+  }
+  RefPtr<nsHashPropertyBag> bag = new nsHashPropertyBag();
+  (void)bag->SetPropertyAsUint64(u"innerWindowID"_ns,
+                                 aDocument->InnerWindowID());
+  os->NotifyObservers(static_cast<nsIWritablePropertyBag2*>(bag),
+                      "darkstr-cookie-gate", nullptr);
+  nsAutoString decision;
+  if (NS_FAILED(bag->GetPropertyAsAString(u"decision"_ns, decision))) {
+    return true;
+  }
+  return !decision.EqualsLiteral("passthrough");
+}
