+export function prepareAcceptLanguages(input) {
+  const list = Array.isArray(input) ? input : String(input || "").split(",");
+  const out = [];
+  for (const raw of list) {
+    let token = String(raw).replace(/^[ \t]+/, "");
+    const cut = token.search(/[; \t]/);
+    if (cut >= 0) {
+      token = token.slice(0, cut);
+    }
