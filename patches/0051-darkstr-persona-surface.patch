+    for (let i = 1; i < subs.length; i++) {
+      if (subs[i].length === 1) {
+        break;
+      }
+      if (subs[i].length === 2) {
+        subs[i] = subs[i].toUpperCase();
+      } else if (subs[i].length === 4) {
+        subs[i] = subs[i][0].toUpperCase() + subs[i].slice(1);
+      }
