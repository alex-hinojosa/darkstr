+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "DarkstrNsHttpHooks.h"
+
+#include "nsHttp.h"
+#include "nsHttpRequestHead.h"
+#include "mozilla/Preferences.h"
+#include "nsString.h"
+
+namespace mozilla::net {
+
+static constexpr const char* kClientHintHeaders[] = {
+    "sec-ch-ua",
+    "sec-ch-ua-mobile",
+    "sec-ch-ua-platform",
+    "sec-ch-ua-platform-version",
+    "sec-ch-ua-arch",
+    "sec-ch-ua-bitness",
+    "sec-ch-ua-model",
+    "sec-ch-ua-full-version-list",
+    "sec-ch-ua-wow64",
+};
+
+// Storage for UserAgentOverride() return — refreshed each call.
+static nsCString gDarkstrUaOverride;
+
+bool DarkstrNsHttpHooks::PollutionNativeHooksActive() {
+  if (!Preferences::GetBool("darkstr.nativePersonaHooks", false)) {
+    return false;
+  }
+  if (Preferences::GetBool("darkstr.nativeCompatible", false)) {
+    return false;
+  }
+  nsAutoCString mode;
+  Preferences::GetCString("darkstr.mode", mode);
+  return mode.EqualsLiteral("pollution");
+}
+
+static bool ExtractUserAgentFromSnapshotJson(const nsACString& aJson,
+                                             nsACString& aOutUa) {
+  // Minimal honest extractor: look for "userAgent":"<value>" only.
+  // Full JSON parse stays in chrome (0003). This is a C++ fallback mirror.
+  // Find "userAgent" then the next quoted string value.
+  nsAutoCString flat(aJson);
+  int32_t keyPos = flat.Find("\"userAgent\"");
+  if (keyPos < 0) {
+    return false;
+  }
+  int32_t colon = flat.Find(":", keyPos + 12);
+  if (colon < 0) {
+    return false;
+  }
+  int32_t firstQuote = flat.Find("\"", colon + 1);
+  if (firstQuote < 0) {
+    return false;
+  }
+  int32_t secondQuote = flat.Find("\"", firstQuote + 1);
+  if (secondQuote < 0 || secondQuote <= firstQuote + 1) {
+    return false;
+  }
+  aOutUa.Assign(Substring(flat, firstQuote + 1, secondQuote - firstQuote - 1));
+  return !aOutUa.IsEmpty();
+}
+
+const nsCString* DarkstrNsHttpHooks::UserAgentOverride() {
+  gDarkstrUaOverride.Truncate();
+  if (!PollutionNativeHooksActive()) {
+    return nullptr;
+  }
+
+  nsAutoCString ua;
+  if (NS_SUCCEEDED(Preferences::GetCString("darkstr.persona.ua", ua)) &&
+      !ua.IsEmpty()) {
+    gDarkstrUaOverride.Assign(ua);
+    return &gDarkstrUaOverride;
+  }
+
+  nsAutoCString snapshot;
+  if (NS_SUCCEEDED(
+          Preferences::GetCString("darkstr.persona.snapshot", snapshot)) &&
+      !snapshot.IsEmpty() &&
+      ExtractUserAgentFromSnapshotJson(snapshot, ua)) {
+    gDarkstrUaOverride.Assign(ua);
+    return &gDarkstrUaOverride;
+  }
+
+  return nullptr;
+}
+
+void DarkstrNsHttpHooks::RemoveClientHintHeaders(nsHttpRequestHead* aRequest) {
+  if (!aRequest || !PollutionNativeHooksActive()) {
+    return;
+  }
+  for (const char* name : kClientHintHeaders) {
+    nsHttpAtom atom = nsHttp::ResolveAtom(nsDependentCString(name));
+    if (atom && aRequest->HasHeader(atom)) {
+      (void)aRequest->ClearHeader(atom);
+    }
+  }
+}
+
+}  // namespace mozilla::net
