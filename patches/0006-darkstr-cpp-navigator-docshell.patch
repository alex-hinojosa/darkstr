+
+bool DarkstrDocShellHooks::PollutionNativeHooksActive() {
+  if (!Preferences::GetBool("darkstr.nativePersonaHooks", false)) {
+    return false;
+  }
+  if (Preferences::GetBool("darkstr.nativeCompatible", false)) {
+    return false;
+  }
+  nsAutoCString mode;
+  Preferences::GetCString("darkstr.mode", mode);
+  return mode.EqualsLiteral("pollution");
+}
+
+DarkstrDocShellHooks::NavPhase DarkstrDocShellHooks::PhaseFromChromeMirror() {
+  // Honest stub: chrome DarkstrNativePersona counter remains SoT (0003).
+  if (!PollutionNativeHooksActive()) {
+    return NavPhase::SubsequentNav;
+  }
+  nsAutoCString phase;
+  if (NS_SUCCEEDED(
+          Preferences::GetCString("darkstr.persona.docShellPhase", phase)) &&
+      phase.EqualsLiteral("first_document")) {
+    return NavPhase::FirstDocument;
+  }
+  return NavPhase::SubsequentNav;
+}
+
+void DarkstrDocShellHooks::NoteTopLevelDocumentLoadAttempt() {
+  // No-op behavioral stub: chrome counter + mirror remain SoT.
+  (void)PhaseFromChromeMirror();
+}
