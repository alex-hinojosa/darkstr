# darkstr 0027 — content-process HW force (Fission-safe gates)
# Train: Firefox FIREFOX_156_0_1_RELEASE / LibreWolf 156.0.1-1 (ported from 155)
#
# Root cause (Proof #52 tip 6560394): TryGetHardwareConcurrency is linked and
# called, but PollutionNativeHooksActive / StrictNextNavArmedMirror read
# dynamic *string* prefs (darkstr.mode, docShellPhase). Fission sanitizes
# those out of web content processes, so C++ gates never arm there. UA 140
# came from JS spoof; hardwareConcurrency WebIDL is non-configurable so JS
# redefine no-ops (hasInst=false) and host 12 leaks.
#
# Fix:
#   1) Gate on bool mirrors darkstr.pollutionActive + docshell.strictNextNavArmed
#      (int/bool prefs are not string-sanitized).
#   2) After gates, never fall closed to host cores (pref int or persona 8).
#   3) WorkerNavigator::HardwareConcurrency uses the same TryGet.
#   4) Chrome writes darkstr.pollutionActive in refreshPlan.
#
# Brand: darkstr — not official LibreWolf.

diff --git a/dom/base/DarkstrNavigatorHooks.cpp b/dom/base/DarkstrNavigatorHooks.cpp
--- a/dom/base/DarkstrNavigatorHooks.cpp
+++ b/dom/base/DarkstrNavigatorHooks.cpp
@@ -15,15 +15,23 @@
 
 namespace {
 
-/** SubsequentNav arm via DocShell phase mirror (0007/0020). Multi-tab limited. */
+/**
+ * SubsequentNav arm. Prefer bool mirror (content-safe under Fission sanitization);
+ * string docShellPhase is a dynamic string and is omitted from web content processes.
+ */
 bool StrictNextNavArmedMirror() {
+  // Chrome DarkstrNativePersona._syncStrictNextNavArmedDiag writes this bool.
+  if (Preferences::GetBool("darkstr.docshell.strictNextNavArmed", false)) {
+    return true;
+  }
   if (!Preferences::GetBool("darkstr.strictFirstDoc", true)) {
     return true;
   }
+  // Parent / non-sanitized fallback only.
   nsAutoCString phase;
   if (NS_FAILED(Preferences::GetCString("darkstr.persona.docShellPhase", phase)) ||
       phase.IsEmpty()) {
-    return false;  // unset = first_document parity
+    return false;
   }
   return phase.EqualsLiteral("subsequent_nav");
 }
@@ -37,6 +45,10 @@
   if (Preferences::GetBool("darkstr.nativeCompatible", false)) {
     return false;
   }
+  // Bool mirror — darkstr.mode is a dynamic string sanitized from content procs.
+  if (Preferences::GetBool("darkstr.pollutionActive", false)) {
+    return true;
+  }
   nsAutoCString mode;
   Preferences::GetCString("darkstr.mode", mode);
   return mode.EqualsLiteral("pollution");
@@ -75,7 +87,7 @@
   if (!PollutionNativeHooksActive() || !StrictNextNavArmedMirror()) {
     return false;
   }
-  // Int mirror (0006). Stale string type / missing user value → GetInt == 0.
+  // Int mirror (0006). Int prefs are not Fission-sanitized like dynamic strings.
   int32_t hw = Preferences::GetInt("darkstr.persona.hardwareConcurrency", 0);
   if (hw <= 0) {
     nsAutoCString hwStr;
@@ -90,18 +102,11 @@
       }
     }
   }
-  // When UA mirror is present under the same gate, prefer persona default 8
-  // over host core count (RFP-off Pollution incoherence — Proof P0).
+  // After gates pass, NEVER fall closed to host core count (Proof P0 / 0027).
+  // Persona default 8 when mirror missing — do not require sanitized UA string.
   if (hw <= 0) {
-    nsAutoCString ua;
-    if (NS_SUCCEEDED(Preferences::GetCString("darkstr.persona.ua", ua)) &&
-        !ua.IsEmpty()) {
-      hw = 8;
-    }
+    hw = 8;
   }
-  if (hw <= 0) {
-    return false;
-  }
   aOut = static_cast<uint64_t>(hw);
   return true;
 }

