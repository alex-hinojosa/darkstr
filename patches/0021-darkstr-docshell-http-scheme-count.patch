+++ b/browser/components/DarkstrNativePersona.sys.mjs
@@ -214,6 +214,13 @@
 
   _noteTopLevelDocument(channel) {
     try {
+      // Only http(s) content docs count — about:blank / about:newtab / chrome
+      // must not burn FirstDocument (Proof XOR / 0020 http-scheme filter).
+      const uri = channel.URI || channel.originalURI;
+      const scheme = String(uri?.scheme || "").toLowerCase();
+      if (scheme !== "http" && scheme !== "https") {
+        return null;
+      }
       const li = channel.loadInfo;
       if (!li) {
         return null;
diff -ruN a/docshell/base/DarkstrDocShellHooks.cpp b/docshell/base/DarkstrDocShellHooks.cpp
--- a/docshell/base/DarkstrDocShellHooks.cpp
+++ b/docshell/base/DarkstrDocShellHooks.cpp
@@ -7,6 +7,7 @@
 #include "DarkstrDocShellHooks.h"
 
 #include "mozilla/Preferences.h"
+#include "nsIURI.h"
 #include "nsString.h"
 #include "nsTHashMap.h"
 
@@ -97,12 +98,25 @@
   return ShouldApplyPersona(aBrowsingContextId);
 }
 
+bool DarkstrDocShellHooks::CountsTowardStrictFirstDoc(nsIURI* aURI) {
+  if (!aURI) {
+    return false;
+  }
+  nsAutoCString scheme;
+  if (NS_FAILED(aURI->GetScheme(scheme))) {
+    return false;
+  }
+  // Proof XOR: about:blank / about:newtab / chrome must not burn FirstDocument
+  // so the first intentional http(s) content nav stays native under strictFirstDoc.
+  return scheme.EqualsLiteral("http") || scheme.EqualsLiteral("https");
+}
+
 void DarkstrDocShellHooks::NoteTopLevelDocumentLoadAttempt(
-    uint64_t aBrowsingContextId) {
+    uint64_t aBrowsingContextId, nsIURI* aURI) {
   if (!PollutionNativeHooksActive()) {
     return;
   }
-  if (aBrowsingContextId == 0) {
+  if (aBrowsingContextId == 0 || !CountsTowardStrictFirstDoc(aURI)) {
     return;
   }
   uint32_t n = 0;
