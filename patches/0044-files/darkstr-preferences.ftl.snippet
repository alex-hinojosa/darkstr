## darkstr preferences

pane-darkstr-title = darkstr
  .title = darkstr
darkstr-header = darkstr
darkstr-mode-heading =
    .label = Mode
darkstr-mode-radio =
    .label = Mode
darkstr-mode-homogeneous =
    .label = Homogeneous
    .description = Stock LibreWolf fingerprinting resistance. Not Pollution.
darkstr-mode-pollution =
    .label = Pollution
    .description = Persona and chaff. Not anti-detect. Not a Cloudflare bypass.
darkstr-native-compatible =
    .label = Native-Compatible
    .description = Beside mode. Restores native identity for banking and SSO. Not a Cloudflare-defeat switch.
darkstr-native-persona-hooks =
    .label = Native persona hooks
    .description = Off by default. Applies the persona in the browser when Pollution is on. Not anti-detect.
