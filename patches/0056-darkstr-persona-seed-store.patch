+        if (!(await this._ensureKey())) {
+          this._state = "session-only";
+          return;
+        }
+      } catch (e) {
+        console.error("darkstr 0056: OSKeyStore unavailable, seeds are session-only", e);
+        this._state = "session-only";
+        return;
+      }
