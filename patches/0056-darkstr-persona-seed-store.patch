+    for (const rec of this._session.values()) {
+      if (!this.keepsSite(rec.ctx, rec.site, sets)) {
+        continue;
+      }
+      const h = this._hash(rec.site);
+      const k = `${rec.ctx}|${h}`;
+      if (!this._disk.has(k)) {
