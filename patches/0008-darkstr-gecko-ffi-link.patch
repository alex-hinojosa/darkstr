+
+let gLib = null;
+let gAbiVersion = null;
+let gSnapshot = null;
+let gFree = null;
+let gLoadAttempted = false;
+let gLoadError = null;
+
+function libraryFileName() {
+  const abi = ctypes.libraryName("duppel_ffi");
+  // ctypes.libraryName("duppel_ffi") → libduppel_ffi.dylib / .so / duppel_ffi.dll
+  return abi;
+}
+
+function candidatePaths() {
+  const name = libraryFileName();
+  const paths = [];
+  try {
+    const cur = Services.dirsvc.get("CurProcD", Ci.nsIFile);
+    paths.push(PathUtils.join(cur.path, name));
+  } catch (_e) {}
+  try {
+    const gre = Services.dirsvc.get("GreD", Ci.nsIFile);
+    paths.push(PathUtils.join(gre.path, name));
+  } catch (_e) {}
+  return paths;
+}
+
+function ensureLoaded() {
+  if (gLib) {
+    return true;
+  }
+  if (gLoadAttempted) {
+    return false;
+  }
+  gLoadAttempted = true;
+  for (const path of candidatePaths()) {
+    try {
+      gLib = ctypes.open(path);
+      gAbiVersion = gLib.declare(
