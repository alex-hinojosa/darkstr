+            mode: Mode::Homogeneous,
+            native_compatible: false,
+            rfp_likely: true,
+        });
+        assert!(
+            generate_persona_if_active(PersonaSeed(9), Engine::Firefox, HostOs::Linux, &act)
+                .is_none()
