+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Mode::Homogeneous => prefs::MODE_HOMOGENEOUS,
+            Mode::Pollution => prefs::MODE_POLLUTION,
+        }
+    }
+}
